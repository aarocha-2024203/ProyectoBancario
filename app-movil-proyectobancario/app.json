{
  "expo": {
    "name": "Banco Kinalito",
    "slug": "banco-kinal",
    "newArchEnabled": true,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08316D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.proyectobancario.clientuser"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08316D"
      },
      "package": "com.proyectobancario.clientuser"
    },
    "web": {
      "favicon": "./assets/splash.png",
      "bundler": "metro",
      "output": "single",
      "entry": "index.js"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ],
    "scheme": "Banco Kinalito",
    "extra": {
      "eas": {
        "projectId": "f7a482c2-f974-4fb5-8644-6fdc2a80574e"
      }
    },
    "owner": "proyecto-bancario-2026-g3"
  }
}
