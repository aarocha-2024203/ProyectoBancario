{
  "expo": {
    "name": "Banco Kinalito",
    "slug": "Banco Kinalito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08316D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.proyectobancario.clientuser"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08316D"
      },
      "package": "com.proyectobancario.clientuser"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "entry": "index.js"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing"
    ],
    "scheme": "Banco Kinalito"
  }
}
