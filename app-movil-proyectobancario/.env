# .env.example
# Copia este archivo como .env y ajusta las URLs a tu entorno.
# Las variables EXPO_PUBLIC_* son accesibles en el bundle del cliente.

# Auth Service (puerto 3005)
EXPO_PUBLIC_AUTH_URL=http://localhost:3005/api/v1

# Banking Service - cuentas, monedas, retiros, depósitos (puerto 3006)
EXPO_PUBLIC_BANKING_URL=http://localhost:3006/api/v1

# Ejemplo para red local (reemplaza 192.168.x.x por la IP de tu máquina)
# EXPO_PUBLIC_AUTH_URL=http://192.168.1.100:3005/api/v1
# EXPO_PUBLIC_BANKING_URL=http://192.168.1.100:3006/api/v1
# Web
# Android Studio (emulador)
#EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:3005/api/v1

# Físico (misma red WiFi)
#EXPO_PUBLIC_AUTH_URL=http://192.168.1.X:3005/api/v1